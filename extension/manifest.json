{
  "manifest_version": 3,
  "name": "피싱 URL·이메일 검사",
  "description": "URL의 피싱 위험을 분석하고 이메일의 의심 문구와 링크를 확인합니다.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "sidePanel", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_title": "피싱 URL·이메일 검사",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/sch-seal16.png",
      "48": "icons/sch-seal48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/sch-seal16.png",
    "48": "icons/sch-seal48.png",
    "128": "icons/sch-seal128.png"
  }
}
